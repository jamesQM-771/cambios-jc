{
  "name": "cambios-jc",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @cambios-jc/api\" \"npm run dev -w @cambios-jc/web\"",
    "db:migrate": "npm run db:migrate -w @cambios-jc/api",
    "db:seed": "npm run db:seed -w @cambios-jc/api",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "check": "npm run lint && npm run typecheck && npm run test",
    "build": "npm run build --workspaces",
    "format": "prettier --write .",
    "postinstall": "npm run db:generate -w @cambios-jc/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
