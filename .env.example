# Copia este archivo como .env y completa los valores. .env nunca se sube al repositorio.
# Entre corchetes, la tarea de la fase 0 que empieza a usar cada variable.

# --- General [0.2] ---
NODE_ENV=development
TZ=UTC

# --- API [0.2] ---
PUERTO_API=3000
HOST_API=127.0.0.1
# Nivel de logs: fatal, error, warn, info, debug, trace o silent.
LOG_NIVEL=info
# [0.6] Límite de peticiones por IP: máximo dentro de la ventana (en segundos).
RATE_LIMIT_MAX=100
RATE_LIMIT_VENTANA_SEGUNDOS=60
# [0.6] true solo detrás de un proxy inverso (producción), para leer la IP real del cliente.
CONFIAR_PROXY=false

# --- Web [0.2] ---
# Vite usa 5173 por defecto. ORIGEN_WEB es el único origen que CORS deja usar la API [0.6].
PUERTO_WEB=5173
ORIGEN_WEB=http://localhost:5173

# --- Base de datos [0.4] ---
# Usuario y bases creados con scripts/db-preparar.sql (PostgreSQL 18 nativo).
DATABASE_URL=postgresql://cambios_jc:CAMBIA_ESTA_CLAVE@localhost:5432/cambios_jc
# Base separada que usan las pruebas de integración; se borra y recrea en cada corrida.
DATABASE_URL_PRUEBAS=postgresql://cambios_jc:CAMBIA_ESTA_CLAVE@localhost:5432/cambios_jc_pruebas

# --- Administrador inicial (seed) [0.4] ---
ADMIN_LOGIN_INICIAL=admin
# Contraseña temporal (mínimo 10 caracteres); se cambia y se configura 2FA en el primer acceso.
ADMIN_CONTRASENA_INICIAL=

# --- Seguridad y sesiones [0.7] ---
# Clave de 32 bytes en base64 para cifrar los secretos 2FA. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO_2FA=
# Minutos de inactividad y horas máximas de una sesión.
SESION_INACTIVIDAD_MINUTOS=30
SESION_MAXIMA_HORAS=12
# Intentos fallidos antes del bloqueo temporal y su duración.
LOGIN_INTENTOS_MAXIMOS=5
LOGIN_BLOQUEO_MINUTOS=15

# --- Archivos [0.9] ---
# Carpeta local para el logo de la empresa (luego almacenamiento compatible S3).
CARPETA_SUBIDAS=./uploads

# --- Monitoreo [0.12] ---
# Opcional: si está vacío, Sentry queda desactivado.
SENTRY_DSN=
