# Finales de línea LF en todo el repositorio (los .sh deben funcionar en Linux y CI).
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.xlsx binary
*.xls binary
*.pdf binary

# Scripts de Windows: CRLF para que cmd y PowerShell los lean sin sorpresas.
*.bat text eol=crlf
*.ps1 text eol=crlf
