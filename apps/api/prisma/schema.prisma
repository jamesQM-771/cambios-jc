// Esquema de la fase 0 (docs/fases/FASE-0.md §0.4).
// Modelos y campos en español camelCase; tablas y columnas en snake_case (D24).
// Fechas en UTC con zona horaria (timestamptz).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  administrador
  vendedor
  digitador

  @@map("rol")
}

/// Configuración de la empresa dueña de la instalación. Una sola fila (restricción en la migración).
model Empresa {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// Siempre true: con el índice único garantiza una sola fila.
  unica          Boolean  @unique @default(true)
  nombre         String
  nit            String?
  telefono       String?
  whatsapp       String?
  direccion      String?
  logoUrl        String?  @map("logo_url")
  monedaLocal    String   @default("COP") @map("moneda_local") @db.Char(3)
  zonaHoraria    String   @default("America/Bogota") @map("zona_horaria")
  textoPieRecibo String?  @map("texto_pie_recibo")
  creadaEn       DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)
  actualizadaEn  DateTime @updatedAt @map("actualizada_en") @db.Timestamptz(6)

  @@map("empresa")
}

model Sucursal {
  id       String         @id @default(uuid(7)) @db.Uuid
  nombre   String         @unique
  ciudad   String
  activa   Boolean        @default(true)
  usuarios Usuario[]
  cajas    Caja[]
  cuentas  CuentaDinero[]

  jornadas Jornada[]

  @@map("sucursal")
}

/// Caja de una sucursal (fase 1). El nombre es único dentro de su sucursal, no en todo el sistema.
model Caja {
  id         String   @id @default(uuid(7)) @db.Uuid
  nombre     String
  sucursalId String   @map("sucursal_id") @db.Uuid
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  activa     Boolean  @default(true)
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  cuentas CuentaDinero[]
  turnos  Turno[]

  @@unique([sucursalId, nombre])
  @@map("caja")
}

/// Catálogo de bancos (fase 1). El código son los 4 primeros dígitos de una cuenta venezolana (§5.1
/// de PROYECTO.md); sirve para identificar el banco de una cuenta y, más adelante, de un beneficiario.
model Banco {
  id         String         @id @default(uuid(7)) @db.Uuid
  codigo     String         @unique @db.VarChar(4)
  nombre     String
  pais       String         @default("VE") @db.Char(2)
  activo     Boolean        @default(true)
  creadoEn   DateTime       @default(now()) @map("creado_en") @db.Timestamptz(6)
  cuentas    CuentaDinero[]
  mediosPago MedioPago[]

  @@map("banco")
}

enum TipoCuenta {
  caja
  banco
  billetera

  @@map("tipo_cuenta")
}

/// Cuenta de dinero (fase 1, §5.9 de PROYECTO.md): catálogo, sin saldo todavía (el saldo sale de los
/// movimientos, que no existen hasta la fase 2/3). bancoId y ultimos4Digitos solo aplican a tipo "banco".
model CuentaDinero {
  id                   String          @id @default(uuid(7)) @db.Uuid
  nombre               String
  tipo                 TipoCuenta
  moneda               String          @db.Char(3)
  bancoId              String?         @map("banco_id") @db.Uuid
  banco                Banco?          @relation(fields: [bancoId], references: [id], onDelete: Restrict)
  ultimos4Digitos      String?         @map("ultimos_4_digitos") @db.VarChar(4)
  sucursalId           String          @map("sucursal_id") @db.Uuid
  sucursal             Sucursal        @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  /// Nombre de la persona titular, en texto libre (D65); se conecta con la tabla Contraparte en la fase 4.
  titular              String?
  responsableId        String?         @map("responsable_id") @db.Uuid
  responsable          Usuario?        @relation(fields: [responsableId], references: [id], onDelete: Restrict)
  activa               Boolean         @default(true)
  limiteDiario         Decimal?        @map("limite_diario") @db.Decimal(18, 3)
  comisionPorDefecto   Decimal?        @map("comision_por_defecto") @db.Decimal(18, 3)
  creadoEn             DateTime        @default(now()) @map("creado_en") @db.Timestamptz(6)
  operacionesIngreso   Operacion[]
  transferenciasOrigen Transferencia[]

  /// Puesto al que pertenece una cuenta de tipo "caja". Sin caja es la bóveda de la sucursal (D116).
  cajaId String? @map("caja_id") @db.Uuid
  caja   Caja?   @relation(fields: [cajaId], references: [id], onDelete: Restrict)

  movimientos MovimientoCuenta[]

  trasladosOrigen  Traslado[] @relation("TrasladoOrigen")
  trasladosDestino Traslado[] @relation("TrasladoDestino")

  gastos Gasto[]

  saldosJornada SaldoCuentaJornada[]

  /// Persona a cuyo nombre está la cuenta, cuando es una contraparte del negocio (§5.9, D137).
  contraparteTitularId String?      @map("contraparte_titular_id") @db.Uuid
  contraparteTitular   Contraparte? @relation(fields: [contraparteTitularId], references: [id], onDelete: Restrict)

  movimientosContraparte MovimientoContraparte[]
  comprasDestino         CompraDivisa[]          @relation("CompraDestino")
  comprasPago            CompraDivisa[]          @relation("CompraPago")
  divisasCuentaDivisa    OperacionDivisa[]       @relation("DivisaCuentaDivisa")
  divisasCuentaPesos     OperacionDivisa[]       @relation("DivisaCuentaPesos")

  @@map("cuenta_dinero")
}

enum ClaseLinea {
  remesa
  divisa_caja

  @@map("clase_linea")
}

enum ModoTasa {
  /// Se publican la tasa de compra y/o venta ya calculadas, tal como se las dan (ej. Dólares).
  directo
  /// Se publica una tasa de referencia del proveedor y un margen; el sistema calcula la venta
  /// (ej. Transferencias a Venezuela: proveedor 4,68 + margen 11 % = venta 5,19). D64.
  porcentaje

  @@map("modo_tasa")
}

/// Línea de negocio (fase 1, §4.3 de PROYECTO.md): remesa (envío a otro país) o divisa_caja (compra/
/// venta de una divisa en efectivo).
model LineaNegocio {
  id                String            @id @default(uuid(7)) @db.Uuid
  nombre            String            @unique
  clase             ClaseLinea
  monedaOrigen      String            @map("moneda_origen") @db.Char(3)
  monedaDestino     String            @map("moneda_destino") @db.Char(3)
  activa            Boolean           @default(true)
  modoTasa          ModoTasa          @default(directo) @map("modo_tasa")
  /// Margen vigente en modo "porcentaje" (D64); null si la línea es "directo" o aún no se configuró.
  margenCompra      Decimal?          @map("margen_compra") @db.Decimal(18, 6)
  margenVenta       Decimal?          @map("margen_venta") @db.Decimal(18, 6)
  creadoEn          DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)
  tasas             Tasa[]
  operaciones       Operacion[]
  operacionesDivisa OperacionDivisa[]

  @@map("linea_negocio")
}

/// Historial de tasas publicadas por línea de negocio (fase 1, §5.2 de PROYECTO.md). Nunca se
/// sobrescribe: publicar una tasa nueva cierra la vigencia de la anterior de esa misma línea.
model Tasa {
  id                String            @id @default(uuid(7)) @db.Uuid
  lineaNegocioId    String            @map("linea_negocio_id") @db.Uuid
  lineaNegocio      LineaNegocio      @relation(fields: [lineaNegocioId], references: [id], onDelete: Restrict)
  /// Solo en modo "porcentaje": la tasa del proveedor y el margen usados ese día (snapshot).
  tasaReferencia    Decimal?          @map("tasa_referencia") @db.Decimal(18, 6)
  margenUsado       Decimal?          @map("margen_usado") @db.Decimal(18, 6)
  /// Solo si la línea opera compra (hoy, Dólares). Null en remesas, que aún no compran (fase 4).
  tasaCompra        Decimal?          @map("tasa_compra") @db.Decimal(18, 6)
  tasaVenta         Decimal           @map("tasa_venta") @db.Decimal(18, 6)
  publicadaPorId    String            @map("publicada_por_id") @db.Uuid
  publicadaPor      Usuario           @relation(fields: [publicadaPorId], references: [id], onDelete: Restrict)
  motivo            String?
  vigenteDesde      DateTime          @default(now()) @map("vigente_desde") @db.Timestamptz(6)
  /// Null mientras es la tasa vigente de su línea; se llena al publicar la siguiente.
  vigenteHasta      DateTime?         @map("vigente_hasta") @db.Timestamptz(6)
  operaciones       Operacion[]
  operacionesDivisa OperacionDivisa[]

  @@map("tasa")
}

/// Catálogo de billetes y monedas por divisa (fase 1), para el conteo por denominación del arqueo
/// de caja (§5.16 de PROYECTO.md, fase 3). "Activa" solo significa que es una denominación válida
/// hoy en esa moneda; no implica que esta instalación opere esa moneda en efectivo (eso lo decide la
/// línea de negocio). El valor se guarda con la precisión de dinero de cada moneda (CLAUDE.md §6):
/// 2 decimales para COP/USD, 3 para VES (D15), por eso la columna usa la de VES (la más precisa).
model Denominacion {
  id       String   @id @default(uuid(7)) @db.Uuid
  moneda   String   @db.Char(3)
  valor    Decimal  @db.Decimal(18, 3)
  activa   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  conteos       ConteoTurno[]
  enOperaciones DenominacionOperacion[]

  @@map("denominacion")
}

model Usuario {
  id                    String            @id @default(uuid(7)) @db.Uuid
  nombre                String
  login                 String            @unique
  hashContrasena        String            @map("hash_contrasena")
  /// La contraseña es temporal (seed o restablecida): se debe cambiar en el próximo acceso.
  debeCambiarContrasena Boolean           @default(true) @map("debe_cambiar_contrasena")
  rol                   Rol
  sucursalId            String?           @map("sucursal_id") @db.Uuid
  sucursal              Sucursal?         @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  activo                Boolean           @default(true)
  /// Secreto TOTP cifrado con CLAVE_CIFRADO_2FA (tarea 0.7). Nunca en texto plano.
  secreto2fa            String?           @map("secreto_2fa")
  tiene2fa              Boolean           @default(false) @map("tiene_2fa")
  /// Último paso de tiempo TOTP aceptado: un mismo código no se puede usar dos veces.
  ultimoPaso2fa         Int?              @map("ultimo_paso_2fa")
  intentosFallidos      Int               @default(0) @map("intentos_fallidos")
  bloqueadoHasta        DateTime?         @map("bloqueado_hasta") @db.Timestamptz(6)
  ultimoAcceso          DateTime?         @map("ultimo_acceso") @db.Timestamptz(6)
  creadoEn              DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)
  sesiones              Sesion[]
  auditorias            Auditoria[]
  tasasPublicadas       Tasa[]
  cuentasResponsable    CuentaDinero[]
  clientesCreados       Cliente[]
  operacionesCreadas    Operacion[]
  eventosOperacion      EventoOperacion[]
  impresionesRecibo     ImpresionRecibo[]
  transferenciasTomadas Transferencia[]   @relation("OperadorTransferencia")

  turnos         Turno[] @relation("TurnoDeUsuario")
  turnosCerrados Turno[] @relation("TurnoCerradoPor")

  movimientosCuenta MovimientoCuenta[]

  trasladosCreados  Traslado[] @relation("TrasladoCreadoPor")
  trasladosAnulados Traslado[] @relation("TrasladoAnuladoPor")

  gastosCreados  Gasto[] @relation("GastoCreadoPor")
  gastosAnulados Gasto[] @relation("GastoAnuladoPor")

  jornadasCerradas Jornada[]       @relation("JornadaCerradaPor")
  eventosJornada   EventoJornada[] @relation("EventoJornadaUsuario")

  contrapartesCreadas    Contraparte[]
  movimientosContraparte MovimientoContraparte[]
  movimientosInventario  MovimientoInventario[]
  comprasCreadas         CompraDivisa[]            @relation("CompraCreadaPor")
  comprasAnuladas        CompraDivisa[]            @relation("CompraAnuladaPor")
  divisasCreadas         OperacionDivisa[]         @relation("DivisaCreadaPor")
  divisasAnuladas        OperacionDivisa[]         @relation("DivisaAnuladaPor")
  perfilesActualizados   PerfilRiesgo[]
  listaRestrictivaCreada EntradaListaRestrictiva[]
  alertasResueltas       AlertaCumplimiento[]      @relation("AlertaResueltaPor")
  solicitudesHechas      SolicitudAprobacion[]     @relation("SolicitudSolicitante")
  solicitudesResueltas   SolicitudAprobacion[]     @relation("SolicitudAprobador")

  @@map("usuario")
}

model Sesion {
  id              String   @id @default(uuid(7)) @db.Uuid
  usuarioId       String   @map("usuario_id") @db.Uuid
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  /// SHA-256 del token que viaja en la cookie. El token nunca se guarda.
  tokenHash       String   @unique @map("token_hash")
  /// false = sesión parcial (contraseña correcta, falta el código 2FA); true = sesión completa.
  completa        Boolean  @default(false)
  creadaEn        DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)
  expiraEn        DateTime @map("expira_en") @db.Timestamptz(6)
  ultimaActividad DateTime @default(now()) @map("ultima_actividad") @db.Timestamptz(6)
  ip              String?
  agenteUsuario   String?  @map("agente_usuario")
  revocada        Boolean  @default(false)

  @@index([usuarioId])
  @@map("sesion")
}

/// Bitácora de solo inserción: un trigger rechaza UPDATE, DELETE y TRUNCATE.
model Auditoria {
  id            BigInt   @id @default(autoincrement())
  fecha         DateTime @default(now()) @db.Timestamptz(6)
  usuarioId     String?  @map("usuario_id") @db.Uuid
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  accion        String
  entidad       String
  entidadId     String?  @map("entidad_id")
  antes         Json?
  despues       Json?
  ip            String?
  agenteUsuario String?  @map("agente_usuario")

  @@index([fecha])
  @@index([accion])
  @@index([usuarioId])
  @@index([entidad, entidadId])
  @@map("auditoria")
}

enum TipoDocumento {
  V
  E
  J
  G
  P
  CC
  CE
  PPT
  PAS
  NIT

  @@map("tipo_documento")
}

enum TipoMedioPago {
  cuenta_bancaria
  pago_movil

  @@map("tipo_medio_pago")
}

/// Persona que paga en el local (remitente) o recibe en destino (beneficiario); una puede ser ambas
/// (fase 2, §5.1 de PROYECTO.md). Único por tipo + número de documento. Nunca se borra (D97).
model Cliente {
  id              String               @id @default(uuid(7)) @db.Uuid
  tipoDocumento   TipoDocumento        @map("tipo_documento")
  numeroDocumento String               @map("numero_documento") @db.VarChar(20)
  nombre          String
  telefono        String?              @db.VarChar(20)
  activo          Boolean              @default(true)
  creadoPorId     String               @map("creado_por_id") @db.Uuid
  creadoPor       Usuario              @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn        DateTime             @default(now()) @map("creado_en") @db.Timestamptz(6)
  mediosPago      MedioPago[]
  remesasEnviadas Operacion[]
  perfilRiesgo    PerfilRiesgo?
  alertas         AlertaCumplimiento[]

  @@unique([tipoDocumento, numeroDocumento])
  @@index([nombre])
  @@map("cliente")
}

/// Dónde recibe el beneficiario: cuenta bancaria (20 dígitos; los 4 primeros son el banco) o pago
/// móvil. Es inmutable: una remesa ya registrada apunta a él y no puede cambiar de destino (D98).
/// Para corregir un dato se crea otro medio y se desactiva el anterior.
model MedioPago {
  id                     String          @id @default(uuid(7)) @db.Uuid
  clienteId              String          @map("cliente_id") @db.Uuid
  cliente                Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  tipo                   TipoMedioPago
  bancoId                String          @map("banco_id") @db.Uuid
  banco                  Banco           @relation(fields: [bancoId], references: [id], onDelete: Restrict)
  /// 20 dígitos, solo en cuenta_bancaria.
  numeroCuenta           String?         @map("numero_cuenta") @db.VarChar(20)
  /// Teléfono del pago móvil (formato venezolano de 11 dígitos), solo en pago_movil.
  telefonoPagoMovil      String?         @map("telefono_pago_movil") @db.VarChar(11)
  titular                String
  tipoDocumentoTitular   TipoDocumento   @map("tipo_documento_titular")
  numeroDocumentoTitular String          @map("numero_documento_titular") @db.VarChar(20)
  activo                 Boolean         @default(true)
  creadoEn               DateTime        @default(now()) @map("creado_en") @db.Timestamptz(6)
  transferencias         Transferencia[]

  @@index([clienteId])
  @@map("medio_pago")
}

enum TipoOperacion {
  /// Remesa de venta COP → VES (§5.3 de PROYECTO.md). Las demás operaciones llegan en fases siguientes.
  remesa_venta

  @@map("tipo_operacion")
}

/// Máquina de estados de la remesa (§8 de PROYECTO.md). "por_aprobar" se agrega en la fase 10.
enum EstadoOperacion {
  registrada
  pago_verificado
  en_cola
  tomada
  completada
  con_incidencia
  devuelta
  anulada

  @@map("estado_operacion")
}

enum FormaPago {
  efectivo
  transferencia

  @@map("forma_pago")
}

/// Operación del vendedor (fase 2). Congela la tasa y los montos al registrarse (§5.2): publicar otra
/// tasa después no la cambia. La fecha la pone el servidor (CLAUDE.md §6).
model Operacion {
  id                String            @id @default(uuid(7)) @db.Uuid
  /// Consecutivo por instalación, sin saltos ni repetidos (D100).
  numeroComprobante Int               @unique @map("numero_comprobante")
  tipo              TipoOperacion
  estado            EstadoOperacion   @default(registrada)
  lineaNegocioId    String            @map("linea_negocio_id") @db.Uuid
  lineaNegocio      LineaNegocio      @relation(fields: [lineaNegocioId], references: [id], onDelete: Restrict)
  /// La tasa publicada que estaba vigente al registrar.
  tasaId            String            @map("tasa_id") @db.Uuid
  tasa              Tasa              @relation(fields: [tasaId], references: [id], onDelete: Restrict)
  remitenteId       String            @map("remitente_id") @db.Uuid
  remitente         Cliente           @relation(fields: [remitenteId], references: [id], onDelete: Restrict)
  formaPago         FormaPago         @map("forma_pago")
  /// Cuenta por donde entró el dinero del cliente.
  cuentaIngresoId   String            @map("cuenta_ingreso_id") @db.Uuid
  cuentaIngreso     CuentaDinero      @relation(fields: [cuentaIngresoId], references: [id], onDelete: Restrict)
  /// Turno de caja de quien la registró (D123). Nulo solo en las remesas anteriores a la fase 3.
  turnoId           String?           @map("turno_id") @db.Uuid
  turno             Turno?            @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  montoPesos        Decimal           @map("monto_pesos") @db.Decimal(18, 2)
  montoBolivares    Decimal           @map("monto_bolivares") @db.Decimal(18, 3)
  tasaCalculada     Decimal           @map("tasa_calculada") @db.Decimal(18, 6)
  tasaUsada         Decimal           @map("tasa_usada") @db.Decimal(18, 6)
  motivoTasa        String?           @map("motivo_tasa")
  /// Un reintento con la misma clave devuelve la operación ya creada, no una nueva (CLAUDE.md §6).
  claveIdempotencia String            @unique @map("clave_idempotencia") @db.VarChar(64)
  /// Código para que el cliente consulte su envío sin iniciar sesión (D111). No se puede adivinar.
  codigoSeguimiento String            @unique @map("codigo_seguimiento") @db.VarChar(16)
  creadoPorId       String            @map("creado_por_id") @db.Uuid
  creadoPor         Usuario           @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn          DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)
  transferencia     Transferencia?
  eventos           EventoOperacion[]
  impresiones       ImpresionRecibo[]

  movimientos MovimientoCuenta[]

  /// Costo promedio de la divisa con que se pagó (§7.3, D140). Null hasta que se completa, o si no había costo conocido.
  costoPromedio         Decimal?               @map("costo_promedio") @db.Decimal(18, 6)
  /// (tasa usada − costo promedio) × bolívares enviados, en pesos.
  gananciaBruta         Decimal?               @map("ganancia_bruta") @db.Decimal(18, 2)
  /// Costo bancario del pago llevado a pesos al costo promedio.
  costoBancarioPesos    Decimal?               @map("costo_bancario_pesos") @db.Decimal(18, 2)
  /// Ganancia bruta − costo bancario en pesos.
  gananciaNeta          Decimal?               @map("ganancia_neta") @db.Decimal(18, 2)
  movimientosInventario MovimientoInventario[]
  alertas               AlertaCumplimiento[]

  @@index([estado, creadoEn])
  @@index([turnoId])
  @@map("operacion")
}

/// A dónde se paga una remesa. El digitador solo ve esto (y el monto en bolívares), nunca la operación.
model Transferencia {
  id          String    @id @default(uuid(7)) @db.Uuid
  operacionId String    @unique @map("operacion_id") @db.Uuid
  operacion   Operacion @relation(fields: [operacionId], references: [id], onDelete: Restrict)
  medioPagoId String    @map("medio_pago_id") @db.Uuid
  medioPago   MedioPago @relation(fields: [medioPagoId], references: [id], onDelete: Restrict)

  /// Digitador que la tiene tomada (null mientras está en cola). El bloqueo es el estado "tomada".
  operadorId         String?       @map("operador_id") @db.Uuid
  operador           Usuario?      @relation("OperadorTransferencia", fields: [operadorId], references: [id], onDelete: Restrict)
  tomadaEn           DateTime?     @map("tomada_en") @db.Timestamptz(6)
  /// Cuenta desde la que se pagó (en la moneda destino) y lo que el digitador cargó al completar.
  cuentaOrigenId     String?       @map("cuenta_origen_id") @db.Uuid
  cuentaOrigen       CuentaDinero? @relation(fields: [cuentaOrigenId], references: [id], onDelete: Restrict)
  /// Número de operación del banco. Una misma referencia no se usa dos veces en la misma cuenta.
  referenciaBancaria String?       @map("referencia_bancaria") @db.VarChar(40)
  costoBancario      Decimal?      @map("costo_bancario") @db.Decimal(18, 3)
  /// Captura del comprobante, relativa a la carpeta de subidas (la genera el servidor).
  comprobanteClave   String?       @map("comprobante_clave")
  completadaEn       DateTime?     @map("completada_en") @db.Timestamptz(6)

  @@unique([cuentaOrigenId, referenciaBancaria])
  @@map("transferencia")
}

/// Historial de estados de una operación; de solo inserción en la práctica (nadie lo edita).
model EventoOperacion {
  id             String           @id @default(uuid(7)) @db.Uuid
  operacionId    String           @map("operacion_id") @db.Uuid
  operacion      Operacion        @relation(fields: [operacionId], references: [id], onDelete: Restrict)
  estadoAnterior EstadoOperacion? @map("estado_anterior")
  estadoNuevo    EstadoOperacion  @map("estado_nuevo")
  motivo         String?
  usuarioId      String           @map("usuario_id") @db.Uuid
  usuario        Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn       DateTime         @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([operacionId, creadoEn])
  @@map("evento_operacion")
}

/// Contadores sin saltos (D100). Se incrementan con UPDATE dentro de la misma transacción que usa el
/// número: si la operación se deshace, el número también, y dos peticiones nunca obtienen el mismo.
model Contador {
  clave String @id
  valor Int

  @@map("contador")
}

/// Cada vez que se imprime el recibo de una remesa. La primera es el original; las siguientes son
/// COPIA (§5.3 de PROYECTO.md). Solo se inserta: sirve para saber quién reimprimió y cuándo.
model ImpresionRecibo {
  id          String    @id @default(uuid(7)) @db.Uuid
  operacionId String    @map("operacion_id") @db.Uuid
  operacion   Operacion @relation(fields: [operacionId], references: [id], onDelete: Restrict)
  usuarioId   String    @map("usuario_id") @db.Uuid
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  esCopia     Boolean   @map("es_copia")
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([operacionId, creadoEn])
  @@map("impresion_recibo")
}

enum EstadoJornada {
  abierta
  cerrada

  @@map("estado_jornada")
}

enum EstadoTurno {
  abierto
  cerrado

  @@map("estado_turno")
}

enum MomentoConteo {
  apertura
  cierre

  @@map("momento_conteo")
}

/// Un día de operación de una sucursal (§5.16 de PROYECTO.md). Se crea sola al abrir el primer turno
/// del día, con la fecha en la zona horaria de la empresa (D118).
model Jornada {
  id           String               @id @default(uuid(7)) @db.Uuid
  sucursalId   String               @map("sucursal_id") @db.Uuid
  sucursal     Sucursal             @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  fecha        DateTime             @db.Date
  estado       EstadoJornada        @default(abierta)
  cerradaEn    DateTime?            @map("cerrada_en") @db.Timestamptz(6)
  cerradaPorId String?              @map("cerrada_por_id") @db.Uuid
  cerradaPor   Usuario?             @relation("JornadaCerradaPor", fields: [cerradaPorId], references: [id], onDelete: Restrict)
  /// Cuántas veces se ha cerrado: cada reapertura y nuevo cierre es otro ciclo (D128).
  ciclo        Int                  @default(0)
  /// Foto del día al cerrar (disponible, remesas, gastos, diferencias de arqueo…). El cierre es de solo lectura.
  resumen      Json?
  creadoEn     DateTime             @default(now()) @map("creado_en") @db.Timestamptz(6)
  turnos       Turno[]
  eventos      EventoJornada[]
  saldosCuenta SaldoCuentaJornada[]

  @@unique([sucursalId, fecha])
  @@map("jornada")
}

/// Periodo en que una persona opera una caja: se abre con conteo y se cierra con arqueo (§5.16).
model Turno {
  id           String        @id @default(uuid(7)) @db.Uuid
  cajaId       String        @map("caja_id") @db.Uuid
  caja         Caja          @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  usuarioId    String        @map("usuario_id") @db.Uuid
  usuario      Usuario       @relation("TurnoDeUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  jornadaId    String        @map("jornada_id") @db.Uuid
  jornada      Jornada       @relation(fields: [jornadaId], references: [id], onDelete: Restrict)
  estado       EstadoTurno   @default(abierto)
  abiertoEn    DateTime      @default(now()) @map("abierto_en") @db.Timestamptz(6)
  cerradoEn    DateTime?     @map("cerrado_en") @db.Timestamptz(6)
  /// Quién lo cerró: la misma persona, o el administrador si el turno quedó olvidado (D127).
  cerradoPorId String?       @map("cerrado_por_id") @db.Uuid
  cerradoPor   Usuario?      @relation("TurnoCerradoPor", fields: [cerradoPorId], references: [id], onDelete: Restrict)
  /// Por qué lo cerró otra persona; solo cuando quien cierra no es su dueño.
  motivoCierre String?       @map("motivo_cierre")
  /// Candados de "un turno abierto por caja y por persona" (D117): valen mientras el turno está
  /// abierto y pasan a null al cerrarlo. Un índice único no se repite, pero los null sí.
  cajaEnUso    String?       @unique @map("caja_en_uso") @db.Uuid
  usuarioEnUso String?       @unique @map("usuario_en_uso") @db.Uuid
  conteos      ConteoTurno[]
  saldos       SaldoTurno[]

  movimientos MovimientoCuenta[]
  operaciones Operacion[]
  traslados   Traslado[]
  gastos      Gasto[]

  movimientosContraparte MovimientoContraparte[]
  compras                CompraDivisa[]
  operacionesDivisa      OperacionDivisa[]

  @@index([jornadaId])
  @@index([cajaId, abiertoEn])
  @@map("turno")
}

/// Cuántos billetes o monedas de cada denominación se contaron al abrir o cerrar un turno.
model ConteoTurno {
  id             String        @id @default(uuid(7)) @db.Uuid
  turnoId        String        @map("turno_id") @db.Uuid
  turno          Turno         @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  momento        MomentoConteo
  moneda         String        @db.Char(3)
  denominacionId String        @map("denominacion_id") @db.Uuid
  denominacion   Denominacion  @relation(fields: [denominacionId], references: [id], onDelete: Restrict)
  /// Valor de la denominación al momento de contar (si luego se edita, el conteo no cambia).
  valor          Decimal       @db.Decimal(18, 3)
  cantidad       Int

  @@index([turnoId, momento])
  @@map("conteo_turno")
}

/// Total contado de una moneda al abrir o cerrar un turno, contra lo que se esperaba (§7.6).
/// Al abrir, lo esperado es el último conteo de cierre de esa caja; al cerrar, apertura + movimientos.
model SaldoTurno {
  id          String        @id @default(uuid(7)) @db.Uuid
  turnoId     String        @map("turno_id") @db.Uuid
  turno       Turno         @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  momento     MomentoConteo
  moneda      String        @db.Char(3)
  /// Null cuando no hay nada contra qué comparar (primer turno de la caja).
  esperado    Decimal?      @db.Decimal(18, 3)
  contado     Decimal       @db.Decimal(18, 3)
  diferencia  Decimal?      @db.Decimal(18, 3)
  explicacion String?

  @@unique([turnoId, momento, moneda])
  @@map("saldo_turno")
}

enum SentidoMovimiento {
  entrada
  salida

  @@map("sentido_movimiento")
}

/// De dónde viene un movimiento. Crece con cada fase (gastos, traslados, devoluciones…).
enum OrigenMovimiento {
  /// El dinero del cliente entra a la cuenta de ingreso de una remesa.
  remesa_ingreso
  /// Sale de la cuenta de origen lo que pagó el digitador (en la moneda destino).
  remesa_pago
  /// Sale el costo bancario de ese pago.
  remesa_costo
  /// Deshace el ingreso de una remesa anulada.
  remesa_anulacion
  /// Sale de la cuenta de ingreso lo que se le devuelve al cliente de una remesa con incidencia.
  remesa_devolucion
  /// Sale de la cuenta de origen de un traslado.
  traslado_salida
  /// Entra a la cuenta de destino de un traslado.
  traslado_entrada
  /// Deshace una de las dos patas de un traslado anulado.
  traslado_anulacion
  /// Sale de la cuenta con la que se pagó un gasto operativo.
  gasto
  /// Sale de la cuenta de la que el dueño retiró dinero para sí.
  retiro_dueno
  /// Deshace un gasto o retiro anulado.
  gasto_anulacion
  /// Dinero que entra o sale por un movimiento de cuenta corriente con una contraparte.
  contraparte
  /// Deshace el dinero de un movimiento de contraparte anulado.
  contraparte_anulacion
  /// Entra a la cuenta de destino la divisa comprada a una contraparte.
  compra_ingreso
  /// Sale de la cuenta en pesos el pago de una compra de contado.
  compra_pago
  /// Deshace un movimiento de una compra anulada.
  compra_anulacion

  /// Entra o sale efectivo por una compra o venta de divisas en caja.
  divisa_entrada
  divisa_salida
  /// Deshace un movimiento de una operación de divisas anulada.
  divisa_anulacion

  @@map("origen_movimiento")
}

/// Libro de las cuentas de dinero (fase 3, D120): cada entrada y salida, con su origen. El saldo de una
/// cuenta es la suma de sus entradas menos sus salidas. Es de solo inserción: un error se corrige con
/// un movimiento contrario que apunta al original (`revierteId`), nunca editando ni borrando.
model MovimientoCuenta {
  id                      String                 @id @default(uuid(7)) @db.Uuid
  cuentaId                String                 @map("cuenta_id") @db.Uuid
  cuenta                  CuentaDinero           @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  sentido                 SentidoMovimiento
  /// Siempre positivo; el sentido dice si entra o sale. En la moneda de la cuenta.
  monto                   Decimal                @db.Decimal(18, 3)
  origen                  OrigenMovimiento
  operacionId             String?                @map("operacion_id") @db.Uuid
  operacion               Operacion?             @relation(fields: [operacionId], references: [id], onDelete: Restrict)
  /// Turno en el que ocurrió, si lo hay (se llena desde la tarea 3.3).
  turnoId                 String?                @map("turno_id") @db.Uuid
  turno                   Turno?                 @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  /// El movimiento que este deshace; cada movimiento se revierte, como mucho, una vez.
  revierteId              String?                @unique @map("revierte_id") @db.Uuid
  /// Traslado del que forma parte (cada traslado tiene dos movimientos: una salida y una entrada).
  gastoId                 String?                @map("gasto_id") @db.Uuid
  gasto                   Gasto?                 @relation(fields: [gastoId], references: [id], onDelete: Restrict)
  trasladoId              String?                @map("traslado_id") @db.Uuid
  traslado                Traslado?              @relation(fields: [trasladoId], references: [id], onDelete: Restrict)
  /// Movimiento de cuenta corriente que movió dinero físico (préstamo, abono, anticipo…).
  movimientoContraparteId String?                @map("movimiento_contraparte_id") @db.Uuid
  movimientoContraparte   MovimientoContraparte? @relation(fields: [movimientoContraparteId], references: [id], onDelete: Restrict)
  /// Compra de divisa que movió este dinero (la divisa que entra o el pago que sale).
  compraId                String?                @map("compra_id") @db.Uuid
  compra                  CompraDivisa?          @relation(fields: [compraId], references: [id], onDelete: Restrict)
  /// Compra o venta de divisas en caja que movió este dinero (fase 5).
  operacionDivisaId       String?                @map("operacion_divisa_id") @db.Uuid
  operacionDivisa         OperacionDivisa?       @relation(fields: [operacionDivisaId], references: [id], onDelete: Restrict)
  revierte                MovimientoCuenta?      @relation("Reversion", fields: [revierteId], references: [id], onDelete: Restrict)
  reversion               MovimientoCuenta?      @relation("Reversion")
  usuarioId               String                 @map("usuario_id") @db.Uuid
  usuario                 Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn                DateTime               @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([cuentaId, creadoEn])
  @@index([operacionId])
  @@index([trasladoId])
  @@index([gastoId])
  @@index([movimientoContraparteId])
  @@index([compraId])
  @@index([operacionDivisaId])
  @@map("movimiento_cuenta")
}

/// Dinero que pasa de una cuenta a otra de la misma moneda (D124): de una caja a la bóveda, de la
/// bóveda a un banco, etc. Son dos movimientos del libro (salida y entrada) que se crean y se
/// anulan juntos. Nada se edita ni se borra: un error se anula con motivo.
model Traslado {
  id                String       @id @default(uuid(7)) @db.Uuid
  origenId          String       @map("origen_id") @db.Uuid
  origen            CuentaDinero @relation("TrasladoOrigen", fields: [origenId], references: [id], onDelete: Restrict)
  destinoId         String       @map("destino_id") @db.Uuid
  destino           CuentaDinero @relation("TrasladoDestino", fields: [destinoId], references: [id], onDelete: Restrict)
  /// En la moneda de las dos cuentas (que es la misma).
  monto             Decimal      @db.Decimal(18, 3)
  nota              String?
  /// Turno abierto de quien lo registró, si lo tenía.
  turnoId           String?      @map("turno_id") @db.Uuid
  turno             Turno?       @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  claveIdempotencia String       @unique @map("clave_idempotencia") @db.VarChar(64)
  creadoPorId       String       @map("creado_por_id") @db.Uuid
  creadoPor         Usuario      @relation("TrasladoCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn          DateTime     @default(now()) @map("creado_en") @db.Timestamptz(6)
  anuladoEn         DateTime?    @map("anulado_en") @db.Timestamptz(6)
  anuladoPorId      String?      @map("anulado_por_id") @db.Uuid
  anuladoPor        Usuario?     @relation("TrasladoAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: Restrict)
  motivoAnulacion   String?      @map("motivo_anulacion")

  movimientos MovimientoCuenta[]

  @@index([origenId, creadoEn])
  @@index([destinoId, creadoEn])
  @@map("traslado")
}

enum TipoGasto {
  /// Resta a la ganancia del día.
  operativo
  /// El dueño saca dinero para sí: no resta a la ganancia.
  retiro_dueno

  @@map("tipo_gasto")
}

/// Catálogo simple de categorías de gasto (arriendo, servicios, nómina…). Se desactivan, no se borran.
model CategoriaGasto {
  id       String   @id @default(uuid(7)) @db.Uuid
  nombre   String   @unique
  activa   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  gastos Gasto[]

  @@map("categoria_gasto")
}

/// Plata que sale de una cuenta sin ser una remesa ni un traslado (D125). Siempre sale de una
/// cuenta, así el arqueo lo ve. Nada se edita ni se borra: un error se anula con motivo.
model Gasto {
  id                String          @id @default(uuid(7)) @db.Uuid
  tipo              TipoGasto
  /// Obligatoria en un gasto operativo; un retiro del dueño puede no llevarla.
  categoriaId       String?         @map("categoria_id") @db.Uuid
  categoria         CategoriaGasto? @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  descripcion       String
  cuentaId          String          @map("cuenta_id") @db.Uuid
  cuenta            CuentaDinero    @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  /// En la moneda de la cuenta.
  monto             Decimal         @db.Decimal(18, 3)
  /// Turno abierto de quien lo registró, si lo tenía.
  turnoId           String?         @map("turno_id") @db.Uuid
  turno             Turno?          @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  claveIdempotencia String          @unique @map("clave_idempotencia") @db.VarChar(64)
  creadoPorId       String          @map("creado_por_id") @db.Uuid
  creadoPor         Usuario         @relation("GastoCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn          DateTime        @default(now()) @map("creado_en") @db.Timestamptz(6)
  anuladoEn         DateTime?       @map("anulado_en") @db.Timestamptz(6)
  anuladoPorId      String?         @map("anulado_por_id") @db.Uuid
  anuladoPor        Usuario?        @relation("GastoAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: Restrict)
  motivoAnulacion   String?         @map("motivo_anulacion")

  movimientos MovimientoCuenta[]

  @@index([cuentaId, creadoEn])
  @@index([creadoEn])
  @@map("gasto")
}

enum TipoEventoJornada {
  cierre
  reapertura

  @@map("tipo_evento_jornada")
}

/// Historial de una jornada: cada cierre y cada reapertura (con su motivo). Solo se inserta.
model EventoJornada {
  id        String            @id @default(uuid(7)) @db.Uuid
  jornadaId String            @map("jornada_id") @db.Uuid
  jornada   Jornada           @relation(fields: [jornadaId], references: [id], onDelete: Restrict)
  tipo      TipoEventoJornada
  usuarioId String            @map("usuario_id") @db.Uuid
  usuario   Usuario           @relation("EventoJornadaUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  motivo    String?
  creadoEn  DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([jornadaId, creadoEn])
  @@map("evento_jornada")
}

/// Saldo que el administrador reportó de una cuenta sin caja (bóveda, banco, billetera) al cerrar la
/// jornada, contra lo esperado (D128). Sin tolerancia: cualquier diferencia lleva explicación.
model SaldoCuentaJornada {
  id          String       @id @default(uuid(7)) @db.Uuid
  jornadaId   String       @map("jornada_id") @db.Uuid
  jornada     Jornada      @relation(fields: [jornadaId], references: [id], onDelete: Restrict)
  ciclo       Int
  cuentaId    String       @map("cuenta_id") @db.Uuid
  cuenta      CuentaDinero @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  moneda      String       @db.Char(3)
  /// Null cuando no hay contra qué comparar (primera vez que se arquea la cuenta).
  esperado    Decimal?     @db.Decimal(18, 3)
  reportado   Decimal      @db.Decimal(18, 3)
  diferencia  Decimal?     @db.Decimal(18, 3)
  explicacion String?

  @@unique([jornadaId, ciclo, cuentaId])
  @@index([cuentaId])
  @@map("saldo_cuenta_jornada")
}

// ---------------------------------------------------------------------------
// Fase 4: contrapartes y cuentas corrientes (§5.8, D137)
// ---------------------------------------------------------------------------

enum TipoContraparte {
  proveedor
  familiar
  socio
  tercero
  otro

  @@map("tipo_contraparte")
}

enum TipoMovimientoContraparte {
  prestamo_otorgado
  prestamo_recibido
  abono_recibido
  abono_entregado
  anticipo_proveedor
  compra_credito
  ajuste
  otro

  @@map("tipo_movimiento_contraparte")
}

model Contraparte {
  id          String          @id @default(uuid(7)) @db.Uuid
  /// Único sin distinguir mayúsculas (índice sobre lower(nombre) en la migración): evita "Sara Castro" y "SARA CASTRO".
  nombre      String
  documento   String?
  telefono    String?
  tipo        TipoContraparte
  notas       String?
  activa      Boolean         @default(true)
  creadoPorId String          @map("creado_por_id") @db.Uuid
  creadoPor   Usuario         @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn    DateTime        @default(now()) @map("creado_en") @db.Timestamptz(6)

  movimientos    MovimientoContraparte[]
  cuentasTitular CuentaDinero[]
  compras        CompraDivisa[]

  @@map("contraparte")
}

/// Cuenta corriente de solo inserción: anular es agregar el movimiento contrario (`revierteId`).
model MovimientoContraparte {
  id                String                    @id @default(uuid(7)) @db.Uuid
  contraparteId     String                    @map("contraparte_id") @db.Uuid
  contraparte       Contraparte               @relation(fields: [contraparteId], references: [id], onDelete: Restrict)
  tipo              TipoMovimientoContraparte
  moneda            String                    @db.Char(3)
  /// Siempre positivo; `signo` dice hacia dónde mueve el saldo.
  monto             Decimal                   @db.Decimal(18, 3)
  /// 1: me debe más (o le debo menos). -1: le debo más (o me debe menos).
  signo             Int                       @db.SmallInt
  /// Cuenta del negocio por la que se movió el dinero; null si es solo reconocimiento de deuda.
  cuentaId          String?                   @map("cuenta_id") @db.Uuid
  cuenta            CuentaDinero?             @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  nota              String?
  /// El movimiento que este anula; cada uno se anula una sola vez.
  revierteId        String?                   @unique @map("revierte_id") @db.Uuid
  revierte          MovimientoContraparte?    @relation("ReversionContraparte", fields: [revierteId], references: [id], onDelete: Restrict)
  reversion         MovimientoContraparte?    @relation("ReversionContraparte")
  turnoId           String?                   @map("turno_id") @db.Uuid
  turno             Turno?                    @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  claveIdempotencia String                    @unique @map("clave_idempotencia") @db.VarChar(64)
  usuarioId         String                    @map("usuario_id") @db.Uuid
  usuario           Usuario                   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn          DateTime                  @default(now()) @map("creado_en") @db.Timestamptz(6)

  movimientosCuenta MovimientoCuenta[]
  compra            CompraDivisa?

  @@index([contraparteId, creadoEn])
  @@index([creadoEn])
  @@map("movimiento_contraparte")
}

// ---------------------------------------------------------------------------
// Fase 4: inventario de divisas, compras a contrapartes y ganancia (§5.6, §7.3, D138 a D141)
// ---------------------------------------------------------------------------

/// Estado vivo del inventario de una divisa. Se bloquea la fila en cada movimiento (SELECT … FOR UPDATE).
model InventarioDivisa {
  moneda        String   @id @db.Char(3)
  /// Unidades compradas y aún no pagadas; puede quedar negativa (se paga más de lo registrado como comprado).
  cantidad      Decimal  @default(0) @db.Decimal(18, 3)
  /// Pesos por unidad; null mientras no haya compras ni inventario inicial.
  costoPromedio Decimal? @map("costo_promedio") @db.Decimal(18, 6)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  movimientos MovimientoInventario[]

  @@map("inventario_divisa")
}

enum OrigenInventario {
  /// Inventario inicial o corrección del administrador, con motivo.
  ajuste
  /// Bolívares (o la divisa) comprados a una contraparte.
  compra
  /// Deshace una compra anulada.
  compra_anulacion
  /// Salen al pagar una remesa (bolívares enviados + costo bancario).
  remesa_pago

  /// Entran al comprarle divisa a un cliente en caja.
  divisa_compra
  /// Salen al venderle divisa a un cliente en caja.
  divisa_venta
  /// Deshace una compra o venta de divisas en caja anulada.
  divisa_anulacion

  @@map("origen_inventario")
}

/// Historial de solo inserción del inventario: cada fila guarda el antes y el después.
model MovimientoInventario {
  id                String            @id @default(uuid(7)) @db.Uuid
  moneda            String            @db.Char(3)
  inventario        InventarioDivisa  @relation(fields: [moneda], references: [moneda], onDelete: Restrict)
  origen            OrigenInventario
  sentido           SentidoMovimiento
  /// Siempre positiva; el sentido dice si entra o sale.
  cantidad          Decimal           @db.Decimal(18, 3)
  /// Tasa de la entrada (compra o ajuste); en una salida, el costo unitario con que salió.
  tasa              Decimal?          @db.Decimal(18, 6)
  cantidadAntes     Decimal           @map("cantidad_antes") @db.Decimal(18, 3)
  costoAntes        Decimal?          @map("costo_antes") @db.Decimal(18, 6)
  cantidadDespues   Decimal           @map("cantidad_despues") @db.Decimal(18, 3)
  costoDespues      Decimal?          @map("costo_despues") @db.Decimal(18, 6)
  compraId          String?           @map("compra_id") @db.Uuid
  compra            CompraDivisa?     @relation(fields: [compraId], references: [id], onDelete: Restrict)
  operacionId       String?           @map("operacion_id") @db.Uuid
  operacion         Operacion?        @relation(fields: [operacionId], references: [id], onDelete: Restrict)
  operacionDivisaId String?           @map("operacion_divisa_id") @db.Uuid
  operacionDivisa   OperacionDivisa?  @relation(fields: [operacionDivisaId], references: [id], onDelete: Restrict)
  nota              String?
  usuarioId         String            @map("usuario_id") @db.Uuid
  usuario           Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn          DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([moneda, creadoEn])
  @@index([compraId])
  @@index([operacionId])
  @@map("movimiento_inventario")
}

enum FormaPagoCompra {
  /// Sale de una cuenta del negocio en pesos.
  contado
  /// Queda en la cuenta corriente de la contraparte (le debo); si había anticipo, lo descuenta.
  credito

  @@map("forma_pago_compra")
}

/// Compra de bolívares (u otra divisa) a una contraparte (§5.6).
model CompraDivisa {
  id                      String                 @id @default(uuid(7)) @db.Uuid
  contraparteId           String                 @map("contraparte_id") @db.Uuid
  contraparte             Contraparte            @relation(fields: [contraparteId], references: [id], onDelete: Restrict)
  moneda                  String                 @db.Char(3)
  /// Divisa recibida, en la cuenta de destino.
  cantidad                Decimal                @db.Decimal(18, 3)
  /// Punto de compra: pesos por unidad.
  tasa                    Decimal                @db.Decimal(18, 6)
  /// cantidad × tasa, fijado en pesos.
  montoPesos              Decimal                @map("monto_pesos") @db.Decimal(18, 2)
  cuentaDestinoId         String                 @map("cuenta_destino_id") @db.Uuid
  cuentaDestino           CuentaDinero           @relation("CompraDestino", fields: [cuentaDestinoId], references: [id], onDelete: Restrict)
  formaPago               FormaPagoCompra        @map("forma_pago")
  /// Cuenta en pesos de la que salió el pago (solo de contado).
  cuentaPagoId            String?                @map("cuenta_pago_id") @db.Uuid
  cuentaPago              CuentaDinero?          @relation("CompraPago", fields: [cuentaPagoId], references: [id], onDelete: Restrict)
  /// Movimiento de cuenta corriente de una compra a crédito.
  movimientoContraparteId String?                @unique @map("movimiento_contraparte_id") @db.Uuid
  movimientoContraparte   MovimientoContraparte? @relation(fields: [movimientoContraparteId], references: [id], onDelete: Restrict)
  nota                    String?
  turnoId                 String?                @map("turno_id") @db.Uuid
  turno                   Turno?                 @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  claveIdempotencia       String                 @unique @map("clave_idempotencia") @db.VarChar(64)
  creadoPorId             String                 @map("creado_por_id") @db.Uuid
  creadoPor               Usuario                @relation("CompraCreadaPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn                DateTime               @default(now()) @map("creado_en") @db.Timestamptz(6)
  anuladoEn               DateTime?              @map("anulado_en") @db.Timestamptz(6)
  anuladoPorId            String?                @map("anulado_por_id") @db.Uuid
  anuladoPor              Usuario?               @relation("CompraAnuladaPor", fields: [anuladoPorId], references: [id], onDelete: Restrict)
  motivoAnulacion         String?                @map("motivo_anulacion")

  movimientosCuenta     MovimientoCuenta[]
  movimientosInventario MovimientoInventario[]

  @@index([contraparteId, creadoEn])
  @@index([creadoEn])
  @@map("compra_divisa")
}

// ---------------------------------------------------------------------------
// Fase 5: divisas en caja (§5.7, D145 a D148)
// ---------------------------------------------------------------------------

enum TipoOperacionDivisa {
  /// El negocio le compra divisa al cliente: entra la divisa, salen pesos.
  compra
  /// El negocio le vende divisa al cliente: sale la divisa, entran pesos.
  venta

  @@map("tipo_operacion_divisa")
}

/// Compra o venta de divisa en efectivo, en la caja del turno de quien la registra.
model OperacionDivisa {
  id                String              @id @default(uuid(7)) @db.Uuid
  /// Mismo consecutivo que las remesas (tabla contador): un solo número de recibo por negocio (D100).
  numeroComprobante Int                 @unique @map("numero_comprobante")
  tipo              TipoOperacionDivisa
  lineaNegocioId    String              @map("linea_negocio_id") @db.Uuid
  lineaNegocio      LineaNegocio        @relation(fields: [lineaNegocioId], references: [id], onDelete: Restrict)
  tasaId            String              @map("tasa_id") @db.Uuid
  tasa              Tasa                @relation(fields: [tasaId], references: [id], onDelete: Restrict)
  moneda            String              @db.Char(3)
  montoDivisa       Decimal             @map("monto_divisa") @db.Decimal(18, 2)
  montoPesos        Decimal             @map("monto_pesos") @db.Decimal(18, 2)
  tasaCalculada     Decimal             @map("tasa_calculada") @db.Decimal(18, 6)
  tasaUsada         Decimal             @map("tasa_usada") @db.Decimal(18, 6)
  motivoTasa        String?             @map("motivo_tasa")
  /// Nombre y documento del cliente, opcionales (la ficha de cumplimiento llega en la fase 7).
  clienteNombre     String?             @map("cliente_nombre")
  clienteDocumento  String?             @map("cliente_documento")
  turnoId           String              @map("turno_id") @db.Uuid
  turno             Turno               @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  cuentaDivisaId    String              @map("cuenta_divisa_id") @db.Uuid
  cuentaDivisa      CuentaDinero        @relation("DivisaCuentaDivisa", fields: [cuentaDivisaId], references: [id], onDelete: Restrict)
  cuentaPesosId     String              @map("cuenta_pesos_id") @db.Uuid
  cuentaPesos       CuentaDinero        @relation("DivisaCuentaPesos", fields: [cuentaPesosId], references: [id], onDelete: Restrict)
  /// Solo en ventas: costo promedio con que salió la divisa y la ganancia (§7.3).
  costoPromedio     Decimal?            @map("costo_promedio") @db.Decimal(18, 6)
  ganancia          Decimal?            @db.Decimal(18, 2)
  impresiones       Int                 @default(0)
  claveIdempotencia String              @unique @map("clave_idempotencia") @db.VarChar(64)
  creadoPorId       String              @map("creado_por_id") @db.Uuid
  creadoPor         Usuario             @relation("DivisaCreadaPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn          DateTime            @default(now()) @map("creado_en") @db.Timestamptz(6)
  anuladoEn         DateTime?           @map("anulado_en") @db.Timestamptz(6)
  anuladoPorId      String?             @map("anulado_por_id") @db.Uuid
  anuladoPor        Usuario?            @relation("DivisaAnuladaPor", fields: [anuladoPorId], references: [id], onDelete: Restrict)
  motivoAnulacion   String?             @map("motivo_anulacion")

  denominaciones        DenominacionOperacion[]
  movimientosCuenta     MovimientoCuenta[]
  movimientosInventario MovimientoInventario[]

  @@index([turnoId])
  @@index([creadoEn])
  @@map("operacion_divisa")
}

/// Billetes recibidos y entregados en una operación de divisas (§5.7).
model DenominacionOperacion {
  id                String            @id @default(uuid(7)) @db.Uuid
  operacionDivisaId String            @map("operacion_divisa_id") @db.Uuid
  operacionDivisa   OperacionDivisa   @relation(fields: [operacionDivisaId], references: [id], onDelete: Restrict)
  /// "entrada" = recibida del cliente; "salida" = entregada al cliente.
  sentido           SentidoMovimiento
  moneda            String            @db.Char(3)
  denominacionId    String            @map("denominacion_id") @db.Uuid
  denominacion      Denominacion      @relation(fields: [denominacionId], references: [id], onDelete: Restrict)
  valor             Decimal           @db.Decimal(18, 3)
  cantidad          Int

  @@index([operacionDivisaId])
  @@map("denominacion_operacion")
}

// ---------------------------------------------------------------------------
// Fase 7: cumplimiento SARLAFT / UIAF (§5.13, §7.7, D150 a D154). Umbrales provisionales (§13, 9).
// ---------------------------------------------------------------------------

enum NivelRiesgo {
  bajo
  medio
  alto

  @@map("nivel_riesgo")
}

/// Ficha ampliada del cliente (§5.13).
model PerfilRiesgo {
  id                 String      @id @default(uuid(7)) @db.Uuid
  clienteId          String      @unique @map("cliente_id") @db.Uuid
  cliente            Cliente     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  actividadEconomica String?     @map("actividad_economica")
  origenFondos       String?     @map("origen_fondos")
  direccion          String?
  pep                Boolean     @default(false)
  nivel              NivelRiesgo @default(bajo)
  motivoNivel        String?     @map("motivo_nivel")
  actualizadoPorId   String      @map("actualizado_por_id") @db.Uuid
  actualizadoPor     Usuario     @relation(fields: [actualizadoPorId], references: [id], onDelete: Restrict)
  actualizadoEn      DateTime    @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("perfil_riesgo")
}

/// Parámetros de cumplimiento de la instalación. Todo null = regla apagada (D150).
model ParametrosCumplimiento {
  id                         String   @id @default(uuid(7)) @db.Uuid
  unica                      Boolean  @unique @default(true)
  /// Acumulado del mes de un remitente (moneda local) a partir del cual se exige la ficha ampliada.
  umbralFichaMensual         Decimal? @map("umbral_ficha_mensual") @db.Decimal(18, 2)
  /// Fraccionamiento: más de N remesas de un remitente en 24 h, cada una por debajo de este monto.
  fraccionamientoCantidad    Int?     @map("fraccionamiento_cantidad")
  fraccionamientoMontoMaximo Decimal? @map("fraccionamiento_monto_maximo") @db.Decimal(18, 2)
  /// Concentración: un beneficiario que recibe de más de M remitentes distintos en 30 días.
  concentracionRemitentes    Int?     @map("concentracion_remitentes")
  actualizadoEn              DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("parametros_cumplimiento")
}

enum FuenteLista {
  onu
  ofac
  propia

  @@map("fuente_lista")
}

/// Lista restrictiva cargada por el administrador (ONU, OFAC o propia). Se desactiva, no se borra.
model EntradaListaRestrictiva {
  id              String      @id @default(uuid(7)) @db.Uuid
  fuente          FuenteLista
  nombre          String
  /// Solo dígitos y letras, sin puntos: se compara exacto contra el documento del cliente.
  numeroDocumento String?     @map("numero_documento") @db.VarChar(20)
  nota            String?
  activa          Boolean     @default(true)
  creadoPorId     String      @map("creado_por_id") @db.Uuid
  creadoPor       Usuario     @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn        DateTime    @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([numeroDocumento])
  @@map("entrada_lista_restrictiva")
}

enum TipoAlerta {
  lista_restrictiva
  fraccionamiento
  concentracion
  ficha_requerida

  @@map("tipo_alerta")
}

enum EstadoAlerta {
  abierta
  descartada
  escalada

  @@map("estado_alerta")
}

model AlertaCumplimiento {
  id            String       @id @default(uuid(7)) @db.Uuid
  tipo          TipoAlerta
  estado        EstadoAlerta @default(abierta)
  clienteId     String       @map("cliente_id") @db.Uuid
  cliente       Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  operacionId   String?      @map("operacion_id") @db.Uuid
  operacion     Operacion?   @relation(fields: [operacionId], references: [id], onDelete: Restrict)
  /// Qué disparó la alerta (cuántas operaciones, montos, coincidencia en la lista…).
  detalle       Json
  justificacion String?
  resueltaPorId String?      @map("resuelta_por_id") @db.Uuid
  resueltaPor   Usuario?     @relation("AlertaResueltaPor", fields: [resueltaPorId], references: [id], onDelete: Restrict)
  resueltaEn    DateTime?    @map("resuelta_en") @db.Timestamptz(6)
  creadoEn      DateTime     @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([estado, creadoEn])
  @@index([clienteId])
  @@map("alerta_cumplimiento")
}

// ---------------------------------------------------------------------------
// Fase 9: liquidez (§5.10, §7.4, D160 a D162)
// ---------------------------------------------------------------------------

/// Umbrales de las alertas de liquidez. Null = alerta apagada.
model ParametrosLiquidez {
  id               String   @id @default(uuid(7)) @db.Uuid
  unica            Boolean  @unique @default(true)
  /// Bolívares libres (en la moneda destino) por debajo de los cuales se alerta.
  umbralLibre      Decimal? @map("umbral_libre") @db.Decimal(18, 3)
  /// Porcentaje del límite diario de una cuenta a partir del cual se alerta (ej. 80).
  porcentajeLimite Int?     @map("porcentaje_limite")
  actualizadoEn    DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("parametros_liquidez")
}

// ---------------------------------------------------------------------------
// Fase 10: doble control (§5.12, D163 a D166)
// ---------------------------------------------------------------------------

/// Qué acciones pasan por aprobación. Todo apagado al instalar.
model ParametrosDobleControl {
  id                String   @id @default(uuid(7)) @db.Uuid
  unica             Boolean  @unique @default(true)
  reaperturaJornada Boolean  @default(false) @map("reapertura_jornada")
  devoluciones      Boolean  @default(false)
  anulaciones       Boolean  @default(false)
  ajustes           Boolean  @default(false)
  actualizadoEn     DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("parametros_doble_control")
}

enum AccionAprobacion {
  reabrir_jornada
  devolver_remesa
  anular_remesa
  anular_divisa
  anular_compra
  anular_gasto
  anular_traslado
  ajuste_contraparte
  ajuste_inventario

  @@map("accion_aprobacion")
}

enum EstadoSolicitud {
  pendiente
  aprobada
  rechazada

  @@map("estado_solicitud")
}

/// Solicitud de doble control: la acción queda guardada y la ejecuta otra persona al aprobarla.
model SolicitudAprobacion {
  id            String           @id @default(uuid(7)) @db.Uuid
  accion        AccionAprobacion
  /// Registro sobre el que actúa (jornada, remesa, contraparte, moneda del inventario…).
  entidadId     String           @map("entidad_id")
  /// Lo necesario para ejecutar la acción al aprobarla (el cuerpo de la petición original).
  datos         Json
  /// Resumen legible para la bandeja.
  descripcion   String
  estado        EstadoSolicitud  @default(pendiente)
  solicitanteId String           @map("solicitante_id") @db.Uuid
  solicitante   Usuario          @relation("SolicitudSolicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)
  aprobadorId   String?          @map("aprobador_id") @db.Uuid
  aprobador     Usuario?         @relation("SolicitudAprobador", fields: [aprobadorId], references: [id], onDelete: Restrict)
  comentario    String?
  resueltaEn    DateTime?        @map("resuelta_en") @db.Timestamptz(6)
  creadoEn      DateTime         @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([estado, creadoEn])
  @@map("solicitud_aprobacion")
}

// ---------------------------------------------------------------------------
// Fase 13: permisos configurables (§6.1, D169 a D171)
// ---------------------------------------------------------------------------

/// Permisos de un rol elegidos por el dueño. Sin fila, el rol usa los de fábrica (packages/shared).
model PermisosRol {
  rol            Rol      @id
  permisos       String[]
  actualizadoPor String   @map("actualizado_por") @db.Uuid
  actualizadoEn  DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)

  @@map("permisos_rol")
}
